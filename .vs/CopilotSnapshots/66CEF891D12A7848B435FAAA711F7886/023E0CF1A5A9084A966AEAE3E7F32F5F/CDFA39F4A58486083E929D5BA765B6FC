namespace WorkerModels
{
    public class Worker(QueueTimesClient queueTimesClient, ILogger<Worker> logger) : BackgroundService
    {
        protected override async Task ExecuteAsync(CancellationToken stoppingToken)
        {
            while (!stoppingToken.IsCancellationRequested)
            {
                if (logger.IsEnabled(LogLevel.Information))
                {
                    logger.LogInformation("Worker running at: {time}", DateTimeOffset.Now);
                }

                var queueTimes = await queueTimesClient
                .GetMagicKingdomQueueTimesAsync(stoppingToken);

                if (queueTimes is not null)
                {
                    ProcessQueueTimes(queueTimes);
                }

                await Task.Delay(TimeSpan.FromMinutes(5), stoppingToken);
            }
        }
        
        private void ProcessQueueTimes(WaitingTimeModel queueTimes)
        {
            foreach (var land in queueTimes.Lands)
            {
                logger.LogInformation("Land: {LandName}", land.Name);

                foreach (var ride in land.Rides)
                {
                    logger.LogInformation(
                        "{RideId} | {RideName} | Open: {IsOpen} | Wait: {WaitTime} min | Updated: {LastUpdated}",
                        ride.Id,
                        ride.Name,
                        ride.IsOpen,
                        ride.WaitTime,
                        ride.LastUpdated);
                }
            }
        }
    }
}